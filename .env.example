# ---- Microsoft 365 connection (from the Azure app registration — see README) ----
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# The mailbox the emails send from (replies + Sent Items go here)
SENDER_EMAIL=dberdin@avantrealestate.com
SENDER_NAME=Dan Berdin

# ---- Portal settings ----
PORTAL_PASSWORD=change-this-password
PORT=8080

# Practice mode: true = simulate sending (no real email). Set false to go live.
DRY_RUN=true

# Pace + safety limits (Microsoft 365 allows ~30 msgs/min and 10,000 recipients/day)
RATE_PER_MINUTE=20
DAILY_SEND_CAP=8000

# ---- Tracking & replies ----
# Opens/clicks only record if recipients' mail apps can reach the portal from
# the internet. Point PUBLIC_URL at that address (e.g. a Cloudflare Tunnel
# like https://mail.avantrealestate.com). Leave blank = tracking off.
PUBLIC_URL=
TRACK_OPENS=true
# How often to auto-check the sender's inbox for replies/bounces (minutes)
REPLY_SCAN_MINUTES=15

# Footer appended to every email (editable per-campaign too)
DEFAULT_FOOTER=Avant Real Estate | 2875 Pomona Blvd, Pomona, CA 91768\nYou are receiving this because you have worked with or inquired with Avant Real Estate. If you would prefer not to receive these emails, simply reply with "Unsubscribe".
